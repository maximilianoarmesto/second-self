{
  "name": "second-self",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "node node_modules/.bin/jest --config jest.config.js",
    "db:generate": "prisma generate --config=prisma.config.ts",
    "db:migrate": "prisma migrate dev --config=prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config=prisma.config.ts",
    "db:push": "prisma db push --config=prisma.config.ts",
    "db:studio": "prisma studio --config=prisma.config.ts",
    "db:seed": "npx tsx prisma/seed.ts",
    "generate:favicon": "tsx scripts/generate-favicon.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.292.0",
    "next": "14.0.3",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "postcss": "^8",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9.0.1",
    "tailwind-merge": "^2.0.0",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  },
  "devDependencies": {
    "@types/eslint": "^8",
    "@types/jest": "^29.5.14",
    "@types/pdf-parse": "^1.1.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.0.3",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.1.0",
    "prisma": "^7.6.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0"
  }
}
