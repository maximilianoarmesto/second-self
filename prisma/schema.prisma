generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id        Int      @id @default(autoincrement())
  cloneName String   @default("My Second Self") @map("clone_name")
  createdAt DateTime @default(now()) @map("created_at")

  settings     Settings?
  documents    Document[]
  chatSessions ChatSession[]
  shareLinks   ShareLink[]

  @@map("owners")
}

model Settings {
  id                    Int      @id @default(autoincrement())
  ownerId               Int      @unique @map("owner_id")
  cloneName             String   @default("My Second Self") @map("clone_name")
  /// Additional persona instructions appended after the core first-person
  /// identity rules that are always injected by buildSystemPrompt() in the
  /// RAG service. Leave empty to use the built-in rules only.
  systemPrompt          String   @default("") @map("system_prompt")
  tone                  String   @default("natural")
  responseLength        String   @default("balanced") @map("response_length")
  openaiApiKeyEncrypted String?  @map("openai_api_key_encrypted")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model Document {
  id               Int            @id @default(autoincrement())
  filename         String
  originalFilename String         @map("original_filename")
  fileSize         Int            @map("file_size")
  pageCount        Int?           @map("page_count")
  status           DocumentStatus @default(PENDING)
  errorMessage     String?        @map("error_message")
  /// Raw PDF bytes retained so the document can be re-processed with an
  /// updated chunking strategy without requiring a new upload.
  fileData         Bytes?         @map("file_data")
  ownerId          Int            @map("owner_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")

  owner  Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]

  @@map("documents")
}

model DocumentChunk {
  id            Int                          @id @default(autoincrement())
  documentId    Int                          @map("document_id")
  chunkIndex    Int                          @map("chunk_index")
  pageNumber    Int                          @map("page_number")
  /// Human-readable document title (original filename) stored directly on the
  /// chunk so retrieval queries can surface rich source citations without an
  /// extra join.
  documentTitle String                       @default("") @map("document_title")
  content       String
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime                     @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

model ChatSession {
  id        Int      @id @default(autoincrement())
  title     String   @default("New Conversation")
  ownerId   Int      @map("owner_id")
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  owner    Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("chat_sessions")
}

model Message {
  id        Int         @id @default(autoincrement())
  content   String
  role      MessageRole
  sessionId Int         @map("session_id")
  sources   Json?
  createdAt DateTime    @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model ShareLink {
  id        Int       @id @default(autoincrement())
  ownerId   Int       @map("owner_id")
  tokenHash String    @unique @map("token_hash")
  label     String    @default("Public Link")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  owner Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("share_links")
}

enum DocumentStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  COMPLETED  @map("completed")
  FAILED     @map("failed")

  @@map("document_status")
}

enum MessageRole {
  USER      @map("user")
  ASSISTANT @map("assistant")
  SYSTEM    @map("system")

  @@map("message_role")
}
