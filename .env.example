# Database
POSTGRES_USER=secondself_user
POSTGRES_PASSWORD=secondself_pass
POSTGRES_DB=secondself_db
POSTGRES_PORT=5488

# Prisma database URL (for local dev outside Docker)
PRISMA_DATABASE_URL=postgresql://secondself_user:secondself_pass@localhost:5488/secondself_db

# OpenAI (optional here — can also be configured in the Settings UI)
OPENAI_API_KEY=
