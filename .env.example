# Database
POSTGRES_USER=secondself_user
POSTGRES_PASSWORD=secondself_pass
POSTGRES_DB=secondself_db
POSTGRES_PORT=5488

# Prisma database URL (for local dev outside Docker)
PRISMA_DATABASE_URL=postgresql://secondself_user:secondself_pass@localhost:5488/secondself_db

# JWT secret used to sign session tokens (generate with: openssl rand -hex 32)
JWT_SECRET=

# OpenAI (optional here — can also be configured in the Settings UI)
OPENAI_API_KEY=

# Seed user credentials — used by `npm run db:seed` (prisma/seed.ts).
# Override these in production; the defaults below are for local dev only.
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=changeme123
