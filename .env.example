# Environment Configuration
# Copy this file to .env and replace all placeholder values before running the app.
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
# SQLAlchemy requires the postgresql+asyncpg:// scheme for async I/O.
DATABASE_URL=postgresql+asyncpg://secondself_user:secondself_pass@localhost:5432/secondself_db
POSTGRES_SERVER=localhost
POSTGRES_USER=secondself_user
POSTGRES_PASSWORD=secondself_pass
POSTGRES_DB=secondself_db
POSTGRES_PORT=5432

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required — obtain your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Supported models: gpt-3.5-turbo, gpt-4, gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-3.5-turbo

# ── Application ───────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_this_in_production
ENVIRONMENT=development
# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── LangChain (optional) ──────────────────────────────────────────────────────
# Set LANGCHAIN_TRACING_V2=true and provide an API key to enable LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# URL that the browser uses to reach the backend API.
# For Docker Compose this stays http://localhost:8000 (the backend port is forwarded).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Second Self
